#!/data/data/com.termux/files/usr/bin/bash
# Terminal Claude: first-run setup.
#
# Installs everything needed to run Claude Code on this device:
#   1. Asks for access to your device storage (so Claude can work on your files).
#   2-3. Updates Termux packages and installs common developer tools.
#   4-5. Creates a small Debian Linux environment with proot-distro. Claude Code
#      only ships Linux (glibc) binaries, not Android ones, so it runs in there.
#   6. Installs Claude Code inside that environment with the official installer.
#   7. Adds the `claude` and `claude-shell` commands, which run in your current
#      directory with your Termux home, /sdcard and GitHub sign-in shared.
#
# Safe to run again: finished steps are skipped.
#   claude-setup --force     redo every step
#   claude-setup --verbose   show the full install output instead of a spinner
#   claude-setup --is-running  exit 0 if setup is running in another tab

# Bump this when the steps change, so existing installs run the new steps after
# an app update (terminal-claude.sh and tc compare it with setup-complete).
SETUP_VERSION=4

set -o pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
STATE_DIR="$HOME/.terminal-claude"
LOG_FILE="$STATE_DIR/setup.log"
LOCK_DIR="$STATE_DIR/setup.lock"
DONE_MARKER="$STATE_DIR/setup-complete"
CONTAINER="claude-env"
IMAGE="debian:stable-slim"
TOTAL_STEPS=7

TERMUX_PACKAGES=(
    proot-distro git openssh curl wget python nodejs-lts ripgrep jq
    nano vim tmux which tar unzip zip termux-api termux-tools
    ttyd net-tools gh
)
DEBIAN_PACKAGES=(
    ca-certificates curl wget git ripgrep procps less nano openssh-client
    python3 nodejs npm unzip xz-utils bash-completion iproute2 gh
)

# The lock holds the PID of the running setup. A lock left behind by a setup that
# was killed (app closed or updated mid-setup) is detected and replaced.
setup_running() {
    local pid
    pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)" || return 1
    [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null &&
        tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q claude-setup
}
if [ "$1" = "--is-running" ]; then setup_running; exit; fi

FORCE=0; VERBOSE=0
for arg in "$@"; do
    case "$arg" in
        --force) FORCE=1 ;;
        --verbose|-v) VERBOSE=1 ;;
    esac
done
[ -t 1 ] || VERBOSE=1   # no spinner when output isn't a terminal

bold=$'\e[1m'; dim=$'\e[2m'; green=$'\e[32m'; yellow=$'\e[33m'; red=$'\e[31m'
accent=$'\e[38;5;173m'; reset=$'\e[0m'

STEP_NUM=0
STEP_TITLE=""
step() {
    STEP_NUM=$((STEP_NUM + 1))
    STEP_TITLE="$1"
    printf '\n%s[%d/%d]%s %s%s%s\n' "$accent" "$STEP_NUM" "$TOTAL_STEPS" "$reset" "$bold" "$1" "$reset"
    echo "==> [$STEP_NUM/$TOTAL_STEPS] $1" >>"$LOG_FILE"
}
ok()   { printf '      %s✓%s %s\n' "$green" "$reset" "$*"; }
note() { printf '      %s%s%s\n' "$dim" "$*" "$reset"; }
warn() { printf '      %s! %s%s\n' "$yellow" "$*" "$reset"; echo "WARN: $*" >>"$LOG_FILE"; }
fail() {
    printf '\n%s✗ %s%s\n' "$red$bold" "$*" "$reset"
    echo "ERROR: $*" >>"$LOG_FILE"
    printf '\n%sLast lines of the log:%s\n' "$dim" "$reset"
    tail -n 12 "$LOG_FILE" | sed 's/^/  /'
    printf '\nUsually this is a dropped internet connection. Run %sclaude-setup%s to try again;\n' "$bold" "$reset"
    printf 'finished steps are skipped. Full log: %s\n' "${LOG_FILE/#$HOME/\~}"
    cleanup
    exit 1
}

# Runs a command with its output going to the log, showing a spinner and the
# elapsed time. With --verbose, the output is shown too.
run() {
    if [ "$VERBOSE" = 1 ]; then
        "$@" 2>&1 | tee -a "$LOG_FILE"
        return "${PIPESTATUS[0]}"
    fi
    "$@" >>"$LOG_FILE" 2>&1 </dev/null &
    local pid=$! i=0 start=$SECONDS frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r      %s%s%s %s%ds%s ' "$accent" "${frames:i++%10:1}" "$reset" "$dim" $((SECONDS - start)) "$reset"
        sleep 0.2
    done
    wait "$pid"
    local rc=$?
    printf '\r\e[K'
    return $rc
}

cleanup() {
    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock >/dev/null 2>&1
    rm -rf "$LOCK_DIR"
}

mkdir -p "$STATE_DIR"
if setup_running; then
    echo "Setup is already running in another tab. Open it with the ☰ Tabs button."
    exit 1
fi
rm -rf "$LOCK_DIR"
mkdir -p "$LOCK_DIR" && echo $$ >"$LOCK_DIR/pid"
trap 'printf "\n"; cleanup; exit 130' INT TERM
export TERMINAL_CLAUDE_SETUP_RUNNING=1
echo "--- claude-setup started $(date) ---" >>"$LOG_FILE"

clear 2>/dev/null
cat <<EOF
${accent}${bold}✦ Setting up Terminal Claude${reset}

This installs Claude Code and developer tools (about 300-500 MB).
It takes 5-15 minutes the first time. Keep the app open and stay online.
EOF

# Keep the device from sleeping and killing the download.
command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1

case "$(uname -m)" in
    aarch64|x86_64) ;;
    *) fail "This device's CPU ($(uname -m)) is 32-bit. Claude Code needs a 64-bit (arm64 or x86_64) device." ;;
esac

mkdir -p "$HOME/projects"
touch "$HOME/.hushlogin"   # the welcome banner comes from terminal-claude.sh instead

# --- 1. Storage access ------------------------------------------------------
step "Access to your phone's files"
if [ -d "$HOME/storage/shared" ] && [ "$FORCE" = 0 ]; then
    ok "Already allowed"
else
    note "Android will ask for permission. Tap Allow."
    termux-setup-storage >/dev/null 2>&1
    for _ in $(seq 1 30); do
        [ -d "$HOME/storage/shared" ] && break
        sleep 1
    done
    if [ -d "$HOME/storage/shared" ]; then
        ok "Allowed: your files are in ~/storage/shared"
    else
        warn "Not allowed yet. Run termux-setup-storage later to allow it."
    fi
fi

# --- 2-3. Termux packages ---------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-y -o Dpkg::Options::=--force-confnew -o Dpkg::Options::=--force-confdef)

step "Updating the terminal's packages"
# Finish any install that was interrupted (app closed mid-setup) before continuing.
run dpkg --configure -a --force-confnew || true
run pkg update "${APT_OPTS[@]}" || run pkg update "${APT_OPTS[@]}" || fail "Could not update packages."
run pkg upgrade "${APT_OPTS[@]}" || fail "Could not upgrade packages."
ok "Up to date"

step "Installing developer tools"
note "git, GitHub CLI, Node.js, Python, ripgrep, nano, vim, tmux, ssh, ..."
run pkg install "${APT_OPTS[@]}" "${TERMUX_PACKAGES[@]}" || fail "Could not install the tools."
ok "Installed"

# --- 4-5. Debian environment ------------------------------------------------
step "Creating the Linux environment for Claude"
container_ok() { proot-distro login "$CONTAINER" -- true >/dev/null 2>&1; }
if container_ok && [ "$FORCE" = 0 ]; then
    ok "Already created"
else
    note "Downloading Debian. This is the longest step."
    if [ "$FORCE" = 1 ] && container_ok; then
        run proot-distro remove "$CONTAINER" || true
    fi
    run proot-distro install --name "$CONTAINER" "$IMAGE" || fail "Could not create the Linux environment."
    container_ok || fail "The Linux environment was created but does not start."
    ok "Created"
fi

step "Installing Linux packages"
# dpkg --configure -a and apt-get -f install repair an install that was
# interrupted (app closed or updated mid-setup).
run proot-distro login "$CONTAINER" -- env DEBIAN_FRONTEND=noninteractive bash -c "
    opts='-y -o Dpkg::Options::=--force-confnew -o Dpkg::Options::=--force-confdef'
    dpkg --configure -a --force-confnew || true
    apt-get update &&
    { apt-get install \$opts --no-install-recommends ${DEBIAN_PACKAGES[*]} ||
      { apt-get install \$opts -f && apt-get install \$opts --no-install-recommends ${DEBIAN_PACKAGES[*]}; }; }
" || fail "Could not install packages in the Linux environment."
ok "Installed"

# --- 6. Claude Code ---------------------------------------------------------
step "Installing Claude Code"
claude_installed() {
    proot-distro login "$CONTAINER" -- sh -c \
        'for c in /root/.local/bin/claude /usr/local/bin/claude; do [ -x "$c" ] && exit 0; done; exit 1' 2>/dev/null
}
claude_new=1
if claude_installed && [ "$FORCE" = 0 ]; then
    claude_new=0
    ok "Already installed (it updates itself)"
# Official native installer first; npm (same native binary) as a fallback.
elif ! run proot-distro login "$CONTAINER" -- bash -c '
    set -e
    curl -fsSL https://claude.ai/install.sh -o /tmp/claude-install.sh
    bash /tmp/claude-install.sh
    rm -f /tmp/claude-install.sh
'; then
    warn "The official installer failed; trying npm instead."
    run proot-distro login "$CONTAINER" -- npm install -g @anthropic-ai/claude-code \
        || fail "Could not install Claude Code."
fi
run proot-distro login "$CONTAINER" -- bash -c '
    cat > /usr/local/bin/claude-launch <<"EOF2"
#!/bin/sh
for c in /root/.local/bin/claude /usr/local/bin/claude /usr/bin/claude; do
    [ -x "$c" ] && exec "$c" "$@"
done
echo "Claude Code is not installed. Run claude-setup in Terminal Claude." >&2
exit 127
EOF2
    chmod 755 /usr/local/bin/claude-launch
    grep -q "/.local/bin" /root/.bashrc 2>/dev/null || echo "export PATH=\"\$HOME/.local/bin:\$PATH\"" >> /root/.bashrc
' || fail "Could not create the Claude launcher."

# Tell Claude about this environment, so the servers it starts can be opened in
# the phone's browser and from other devices. Not overwritten if you edit it.
proot-distro login "$CONTAINER" -- bash -c '
    mkdir -p /root/.claude
    f=/root/.claude/CLAUDE.md
    if [ ! -f "$f" ] || grep -q "^<!-- terminal-claude:managed -->" "$f"; then
        cat > "$f" <<"EOF2"
<!-- terminal-claude:managed -->
<!-- Delete the line above to keep your own edits to this file. -->
# Environment: Terminal Claude on Android

- You are running in a Debian proot environment inside the Terminal Claude
  Android app (a Termux build), on a phone. There is no root on the real device
  and no systemd; run servers as normal foreground or background processes.
- The user is on a small touch screen: keep answers and summaries short, and
  prefer making changes over printing long code blocks for them to copy.
- Projects live in /data/data/com.termux/files/home/projects (~/projects in
  Termux). The phone shared storage is at /sdcard (also /storage/emulated/0);
  it does not support symlinks or executable bits, so do not run npm install
  or create virtualenvs there.
- The network is shared with the phone. A server you start here is reachable
  in the phone browser at http://localhost:PORT.
- Use ports 1024 and above. Ports below 1024 are not allowed on Android.
- Bind dev servers to 0.0.0.0 (for example `vite --host`, `next dev -H 0.0.0.0`,
  `python3 -m http.server 8000 --bind 0.0.0.0`) so the user can also open them
  from a computer on the same Wi-Fi at http://PHONE_IP:PORT. Run `hostname -I`
  or `ip -4 addr` to find PHONE_IP, or tell the user to run `remote-access status`
  in Termux.
- Install missing tools with `apt-get install -y PACKAGE`.
- GitHub: `git` and the GitHub CLI `gh` are installed and share the sign-in
  made with `github-login` in Termux. If `gh auth status` says you are not
  signed in, ask the user to tap the GitHub button (or run `github-login`).
EOF2
    fi
' >>"$LOG_FILE" 2>&1 || warn "Could not write /root/.claude/CLAUDE.md"
[ "$claude_new" = 1 ] && ok "Installed"

# --- 7. Commands ------------------------------------------------------------
step "Finishing up"
# The claude and claude-shell commands are installed by the app itself.
if version="$(bash "$PREFIX/bin/claude" --version 2>>"$LOG_FILE")"; then
    echo "claude --version: $version" >>"$LOG_FILE"
    ok "Claude Code ${version%% *} is ready"
else
    fail "Claude Code was installed but did not start."
fi

echo "$SETUP_VERSION" >"$DONE_MARKER"
cleanup
trap - INT TERM

# --- GitHub (optional) ------------------------------------------------------
if [ -t 0 ] && ! gh auth status --hostname github.com >/dev/null 2>&1; then
    echo
    read -r -p "Sign in to GitHub now, so you and Claude can clone and push? [y/N] " answer
    case "$answer" in
        [yY]*) "$PREFIX/bin/bash" "$PREFIX/bin/github-login" || warn "Skipped. Tap GitHub later." ;;
        *) note "Skipped. Tap the GitHub button any time." ;;
    esac
fi

cat <<EOF

${green}${bold}✓ All set!${reset}

  Tap ${accent}${bold}✦ Claude${reset} below to pick a project and start coding,
  or type ${bold}claude${reset} here. Tap ${bold}?${reset} for everything else.

  The first time, Claude asks you to sign in: tap the link it shows,
  sign in, and paste the code back here.

EOF
